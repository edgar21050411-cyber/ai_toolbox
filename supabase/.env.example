# ==============================================================================
# AI TOOLBOX — BACKEND ENVIRONMENT SECRETS (SUPABASE EDGE FUNCTIONS)
# ==============================================================================
# Estas variables residen de forma segura y exclusiva en Supabase Secrets:
# supabase secrets set GEMINI_API_KEY=... OPENAI_API_KEY=... REPLICATE_API_TOKEN=...

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Generación de Texto y Generación de Imágenes (Google Imagen 3)
GEMINI_API_KEY=AIzaSy...your-gemini-api-key

# Fallback de Texto y Marketing
OPENAI_API_KEY=sk-...your-openai-api-key

# Procesamiento Real de Imágenes (improve_image, remove_background, change_background)
# Proveedor principal: Replicate (Real-ESRGAN, bria/remove-background, bria/generate-background)
REPLICATE_API_TOKEN=r8_...your-replicate-api-token

# Proveedor alternativo opcional para segmentación
# REMOVE_BG_API_KEY=your-remove-bg-key

DENO_ENV=development
